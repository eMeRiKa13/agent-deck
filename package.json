{
  "name": "agent-deck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri dev",
    "clean:rust": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo clean --manifest-path src-tauri/Cargo.toml",
    "build": "vue-tsc --noEmit && vite build",
    "build:desktop": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri build",
    "preview": "vite preview --host 127.0.0.1 --port 1421",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/open-sans": "^5.2.7",
    "@fontsource/poppins": "^5.2.8",
    "@lucide/vue": "^1.21.0",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@vueuse/core": "^14.3.0",
    "vue": "^3.5.38",
    "vue-i18n": "^11.4.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.9.4",
    "@types/node": "^26.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.7.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.0",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.3.5"
  }
}
